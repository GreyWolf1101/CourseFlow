<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="课序 · 课程表" android:textSize="15sp" android:textColor="#243D39" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天 · 明天" android:textSize="12sp" android:textColor="#53706A"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="10dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今天" android:textSize="13sp" android:textColor="#71837F"/>
   <TextView android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="今天没有课啦" android:textSize="13sp" android:textColor="#243D39"/>
  </LinearLayout>
  <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="24dp" android:background="#CCD6D1" android:contentDescription="@null"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="10dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="明天" android:textSize="13sp" android:textColor="#71837F"/>
   <TextView android:id="@+id/widget_tomorrow" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="明天没有课啦" android:textSize="13sp" android:textColor="#243D39"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>